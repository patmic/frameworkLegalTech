  <owl:Ontology rdf:about="http://maltg.arch/onto">
    <rdfs:label>MALTG Ontology — Multidimensional Architecture for LegalTech Governance</rdfs:label>
    <rdfs:comment>Ontología de la arquitectura de gobernanza LegalTech. Capas = clusters expandibles: Foundation (TOGAF, COBIT, ITIL, NIST CSF), Technology Integration (AI, Blockchain, Open Data, Security), Operational, Strategic y Governance &amp; Compliance. Derivada de MALTG_architecture.json.</rdfs:comment>
    <owl:versionInfo>4.0.0-architecture</owl:versionInfo>
  </owl:Ontology>

  <owl:AnnotationProperty rdf:about="http://maltg.arch/onto#layer"><rdfs:label>layer</rdfs:label><rdfs:comment>Cluster/normativa para el radar de validación: core|foundation|tech|togaf|cobit|itil|nist|ai|blockchain|opendata|security|operational|strategic|legaltech</rdfs:comment></owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://maltg.arch/onto#cluster"><rdfs:label>cluster</rdfs:label><rdfs:comment>Capa de la arquitectura (cluster expandible): Foundation|Technology|Operational|Strategic|Governance</rdfs:comment></owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://maltg.arch/onto#radius"><rdfs:label>radius</rdfs:label><rdfs:comment>Radio visual del nodo (px)</rdfs:comment></owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://maltg.arch/onto#score"><rdfs:label>score</rdfs:label><rdfs:comment>Madurez de implementación (0-100)</rdfs:comment></owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://maltg.arch/onto#description"><rdfs:label>description</rdfs:label><rdfs:comment>Descripción para tooltips</rdfs:comment></owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://maltg.arch/onto#regulation"><rdfs:label>regulation</rdfs:label><rdfs:comment>Norma/marco de referencia</rdfs:comment></owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="http://maltg.arch/onto#weight"><rdfs:label>weight</rdfs:label><rdfs:comment>Peso de la relación (float)</rdfs:comment></owl:AnnotationProperty>

