[
  {
    "id": "CQ01",
    "pregunta": "¿Qué actos, por etapa, componen el procedimiento sumario?",
    "tipo": "actos_por_procedimiento",
    "params": {
      "proc": "SUMARIO"
    },
    "sparql": "SELECT ?etapa ?acto WHERE { cogep:SUMARIO cogep:tieneEtapa ?etapa . ?etapa cogep:contieneActo ?acto }"
  },
  {
    "id": "CQ02",
    "pregunta": "¿Qué términos (reglas) aplican al procedimiento sumario y qué artículo los fija?",
    "tipo": "reglas_por_procedimiento",
    "params": {
      "proc": "SUMARIO"
    },
    "sparql": "SELECT ?regla ?art WHERE { ?regla a cogep:TerminoProcesal ; cogep:aplicaA cogep:SUMARIO ; rdfs:comment ?art }"
  },
  {
    "id": "CQ03",
