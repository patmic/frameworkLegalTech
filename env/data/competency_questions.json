    "tipo": "termino_de_acto",
    "params": {
      "acto": "act_calificacion"
    },
    "sparql": "SELECT ?regla WHERE { ?regla cogep:actoHasta cogep:act_calificacion }"
  },
  {
    "id": "CQ06",
    "pregunta": "¿Qué actos procesales del catálogo no tienen término asociado (no evaluables)?",
    "tipo": "actos_sin_termino",
    "params": {},
    "sparql": "SELECT ?acto WHERE { ?acto a cogep:ActoProcesal . FILTER NOT EXISTS { ?r cogep:actoHasta ?acto } }"
  },
