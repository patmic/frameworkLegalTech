    "tipo": "reglas_por_procedimiento",
    "params": {
      "proc": "MONITORIO"
    },
    "sparql": "SELECT ?regla WHERE { ?regla a cogep:TerminoProcesal ; cogep:aplicaA cogep:MONITORIO }"
  },
  {
    "id": "CQ04",
    "pregunta": "¿Qué término rige la emisión de la sentencia y desde qué acto se computa?",
    "tipo": "termino_de_acto",
    "params": {
      "acto": "act_sentencia"
    },
    "sparql": "SELECT ?regla ?desde WHERE { ?regla cogep:actoHasta cogep:act_sentencia ; cogep:actoDesde ?desde }"
  },
