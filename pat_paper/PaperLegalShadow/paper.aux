\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The GET-SDS acquisition process. (\textbf  {a}) The non-invasive pipeline, from a parameterised target URL to the coverage set $R$. (\textbf  {b}) The ontology rendered as a celestial sphere: each class is a star, each governance cluster a named constellation. The sphere starts uniformly dim and a scan lights only the classes for which evidence was found, making the anchoring function $\Gamma $ and the coverage set $R$ directly observable. Open data, interoperability and the LegalTech domain light up; TOGAF, COBIT, ITIL, NIST CSF, AI and DLT remain dim.\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:getsds}{{4}{8}{The GET-SDS acquisition process. (\textbf {a}) The non-invasive pipeline, from a parameterised target URL to the coverage set $R$. (\textbf {b}) The ontology rendered as a celestial sphere: each class is a star, each governance cluster a named constellation. The sphere starts uniformly dim and a scan lights only the classes for which evidence was found, making the anchoring function $\Gamma $ and the coverage set $R$ directly observable. Open data, interoperability and the LegalTech domain light up; TOGAF, COBIT, ITIL, NIST CSF, AI and DLT remain dim.\relax }{figure.caption.7}{}}
\newlabel{fig:getsds@cref}{{[figure][4][]4}{[1][8][]8}}
